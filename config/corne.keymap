#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_es_latin_american.h"

// Only turn off if the key is held 3 seconds

&soft_off { hold-time-ms = <3000>; };

// LEDs per half (27 = underglow + per-key; use 10 if you only have underglow)

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I         &kp O       &kp P           &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K         &kp L       &kp ES_N_TILDE  &kp ES_ACUTE
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp ES_COMMA  &kp ES_DOT  &kp ES_MINUS    &kp ENTER
                         &kp LGUI  &mo 1  &kp SPACE    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ES_PIPE   &kp ES_DOUBLE_QUOTES  &kp ES_HASH              &kp ES_DOLLAR             &kp ES_PERCENT       &kp ES_AMPERSAND        &kp ES_QUESTION    &kp ES_AT             &kp ES_CARET         &kp ES_DEG                &kp ES_TILDE                 &kp BSPC
&kp CAPSLOCK  &kp ES_GREATER_THAN   &kp ES_LEFT_PARENTHESIS  &kp ES_RIGHT_PARENTHESIS  &kp ES_LEFT_BRACKET  &kp ES_RIGHT_BRACKET    &kp ES_LEFT_BRACE  &kp ES_RIGHT_BRACE    &kp ES_GRAVE         &kp ES_SEMICOLON          &kp ES_MINUS                 &kp ES_PLUS
&kp LCTRL     &kp ES_LESS_THAN      &kp ES_ASTERISK          &kp ES_EXCLAMATION        &kp ES_BACKSLASH     &kp ES_EQUAL            &kp ES_SLASH       &kp ES_DOUBLE_QUOTES  &kp ES_SINGLE_QUOTE  &kp ES_INVERTED_QUESTION  &kp ES_INVERTED_EXCLAMATION  &kp RETURN
                                                             &kp LSHIFT                &trans               &kp SPACE               &kp RET            &trans                &kp RALT
            >;
        };

        lower_layer {
            bindings = <
&kp C_VOL_UP       &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_INC    &kp ES_PLUS   &kp CAPSLOCK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp BACKSPACE
&kp K_MUTE         &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_DEC    &kp ES_DOT    &kp ES_COMMA  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp PRINTSCREEN
&kp C_VOLUME_DOWN  &trans  &trans  &trans  &trans  &trans                  &kp ES_MINUS  &kp KP_N0     &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp RETURN
                                   &trans  &to 3   &kp SPACE               &kp SPACE     &trans        &trans
            >;
        };

        config_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp F1      &kp F2          &kp F3        &kp F4          &kp F5           &kp F6          &kp F7           &kp F8  &kp F9           &kp F10           &kp F11     &kp F12
&bl BL_INC  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4    &rgb_ug RGB_EFR  &trans  &rgb_ug RGB_EFF  &kp C_AC_DEL      &kp INSERT  &kp PRINTSCREEN
&bl BL_DEC  &bt BT_CLR_ALL  &bt BT_CLR    &studio_unlock  &rgb_ug RGB_TOG  &bl BL_TOG      &trans           &trans  &trans           &ext_power EP_ON  &soft_off   &kp ENTER
                                          &kp LGUI        &to 0            &kp SPACE       &kp RET          &trans  &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
